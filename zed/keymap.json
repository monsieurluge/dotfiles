[
    {
        "context": "Editor",
        "bindings": {
            "pagedown": "editor::MovePageDown",
            "pageup": "editor::MovePageUp",
            "shift-pagedown": "editor::MoveToEndOfParagraph",
            "shift-pageup": "editor::MoveToStartOfParagraph",
            "ctrl-/": "editor::ToggleComments",
            "ctrl-;": "editor::GoToDefinition",
            "ctrl-a": null,
            "ctrl-d": ["editor::SelectNext", { "replace_newest": false }],
            "ctrl-e": "editor::DeleteLine",
            "ctrl-f": "file_finder::Toggle",
            "ctrl-g": null,
            "ctrl-h": null,
            "ctrl-j": "editor::ShowCompletions",
            "ctrl-k": null,
            "ctrl-l": "go_to_line::Toggle",
            "ctrl-m": "editor::MoveToEnclosingBracket",
            "ctrl-n": ["editor::SelectNext", { "replace_newest": true }],
            "ctrl-o": "outline::Toggle",
            "ctrl-p": "command_palette::Toggle",
            "ctrl-r": "editor::Rename",
            "ctrl-t": null,
            "ctrl-y": "pane::RevealInProjectPanel",
            "ctrl-backspace": "editor::DeleteToPreviousWordStart",
            "ctrl-delete": "editor::DeleteToNextWordEnd",
            "ctrl-down": "editor::MoveLineDown",
            "ctrl-enter": "editor::NewlineBelow",
            "ctrl-left": "editor::MoveToPreviousWordStart",
            "ctrl-right": "editor::MoveToNextWordEnd",
            "ctrl-tab": "pane::ActivateNextItem",
            "ctrl-shift-tab": "pane::ActivatePreviousItem",
            "ctrl-up": "editor::MoveLineUp",
            "ctrl-shift-d": "editor::SelectAllMatches",
            "ctrl-shift-e": "editor::DuplicateLineDown",
            "ctrl-shift-k": "editor::AddSelectionBelow",
            "ctrl-shift-l": "editor::AddSelectionAbove",
            "ctrl-shift-p": ["projects::OpenRecent", { "create_new_window": false }],
            "ctrl-shift-y": "project_panel::ToggleFocus",
            "ctrl-shift-enter": "editor::NewlineAbove",
            "ctrl-shift-left": "editor::SelectToPreviousWordStart",
            "ctrl-shift-right": "editor::SelectToNextWordEnd",
            // ACTIONS COMMANDS ------------------------------
            "ctrl-k a": "editor::ToggleCodeActions",
            "ctrl-k d": "diagnostics::Deploy",
            "ctrl-k f": "editor::Format",
            "ctrl-k h": "editor::Hover",
            "ctrl-k o": "editor::OrganizeImports",
            "ctrl-k s": "editor::SortLinesCaseSensitive",
            "ctrl-k tab": "tab_switcher::ToggleAll",
            "ctrl-k shift-tab": "workspace::ActivatePreviousPane",
            // GO COMMANDS ------------------------------
            "ctrl-g b": "editor::MoveToEnd",
            "ctrl-g d": "editor::GoToDiagnostic",
            "ctrl-g shift-d": "editor::GoToPreviousDiagnostic",
            "ctrl-g f": "file_finder::Toggle",
            "ctrl-g l": "go_to_line::Toggle",
            "ctrl-g r": "editor::FindAllReferences",
            "ctrl-g t": "editor::MoveToBeginning",
            // UI COMMANDS ------------------------------
            "cmd-=": "zed::ResetAllZoom",
            "ctrl-u :": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }],
            "ctrl-u f": "editor::Fold",
            "ctrl-u g": "editor::ToggleLineNumbers",
            "ctrl-u h": "editor::ToggleInlayHints",
            "ctrl-u i": "editor::ToggleIndentGuides",
            "ctrl-u m": "editor::ToggleMinimap",
            "ctrl-u shift-f": "editor::UnfoldLines",
            "ctrl-u shift-j": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }],
            "ctrl-u shift-k": ["workspace::MoveItemToPaneInDirection", { "direction": "down" }],
            "ctrl-u shift-l": ["workspace::MoveItemToPaneInDirection", { "direction": "up" }],
            "ctrl-u w": "editor::ToggleSoftWrap",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-f": "file_finder::Toggle",
            "ctrl-p": "command_palette::Toggle",
            "ctrl-k tab": "tab_switcher::ToggleAll",
            "cmd-f": "pane::DeploySearch",
            "cmd-shift-f": [
                "pane::DeploySearch",
                {
                    "replace_enabled": true,
                },
            ],
            "cmd-shift-m": "diagnostics::Deploy",
            "ctrl-shift-p": [
                "projects::OpenRecent",
                {
                    "create_new_window": false,
                },
            ],
            "ctrl-u ;": "workspace::ActivatePaneRight",
            "ctrl-u a": "agent::ToggleFocus",
            "ctrl-u b": "workspace::ToggleLeftDock",
            "ctrl-u e": "editor::ToggleFocus",
            "ctrl-u j": "workspace::ActivatePaneLeft",
            "ctrl-u k": "workspace::ActivatePaneDown",
            "ctrl-u l": "workspace::ActivatePaneUp",
            "ctrl-u p": "project_panel::ToggleFocus",
            "ctrl-u s": "multi_workspace::ToggleWorkspaceSidebar",
            "ctrl-u z": "workspace::ToggleCenteredLayout",
        },
    },
    {
        "context": "Editor && renaming",
        "bindings": {
            "enter": "editor::ConfirmRename",
        },
    },
    {
        "context": "Editor && multibuffer",
        "bindings": {
            "ctrl-;": "editor::OpenExcerpts", // same as "go to definition"
        },
    },
    {
        "context": "Editor && showing_completions",
        "bindings": {
            "enter": "editor::Newline",
            "pagedown": "editor::NextEditPrediction",
            "pageup": "editor::PreviousEditPrediction",
            "tab": "editor::ConfirmCompletion",
        },
    },
    {
        "context": "Editor && edit_prediction && !showing_completions",
        "bindings": {
            "enter": "editor::Newline",
            "pagedown": "editor::NextEditPrediction",
            "pageup": "editor::PreviousEditPrediction",
            "right": "editor::ConfirmCompletion",
            "tab": "editor::AcceptEditPrediction",
        },
    },
    {
        "context": "Editor && !edit_prediction",
        "bindings": {
            "ctrl-shift-j": "editor::ShowEditPrediction",
        },
    },
    {
        "context": "Editor && showing_code_actions",
        "bindings": {
            "enter": "editor::ConfirmCodeAction",
        },
    },
    {
        "context": "Editor && (showing_code_actions || showing_completions)",
        "bindings": {
            "down": "editor::ContextMenuNext",
            "up": "editor::ContextMenuPrevious",
            "pagedown": "editor::ContextMenuLast",
            "pageup": "editor::ContextMenuFirst",
            "ctrl-n": "editor::ContextMenuNext",
            "ctrl-p": "editor::ContextMenuPrevious",
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "tab": "project_panel::OpenPermanent",
            "enter": "project_panel::Rename",
            "cmd-shift-n": "project_panel::NewDirectory",
            "cmd-r": "project_panel::RevealInFileManager",
        },
    },
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "space": "project_panel::Open",
        },
    },
    {
        "context": "CollabPanel && not_editing",
        "bindings": {
            "ctrl-backspace": "collab_panel::Remove",
            "space": "menu::Confirm",
        },
    },
    {
        "context": "(CollabPanel && editing) > Editor",
        "bindings": {
            "space": "collab_panel::InsertSpace",
        },
    },
    {
        "context": "ChannelModal",
        "bindings": {
            "tab": "channel_modal::ToggleMode",
        },
    },
    {
        "context": "ChannelModal > Picker > Editor",
        "bindings": {
            "tab": "channel_modal::ToggleMode",
        },
    },
    {
        "context": "FileFinder",
        "bindings": {
            "cmd-shift-p": "file_finder::SelectPrevious",
        },
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "up": "menu::SelectPrevious",
            "down": "menu::SelectNext",
            "cmd-w": "tab_switcher::CloseSelectedItem",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "ctrl-a c": "search::ToggleCaseSensitive",
            "ctrl-a w": "search::ToggleWholeWord",
            "ctrl-a r": "search::ToggleRegex",
            "ctrl-a f": "project_search::ToggleFilters",
        },
    },
]
